{
  "name": "plansentry",
  "version": "0.1.1",
  "description": "Plan-aware guardrail for AI coding agents: blocks terraform apply / cdk deploy runs that would delete or replace your databases, buckets and keys.",
  "author": "Robey Beswick",
  "homepage": "https://github.com/RobeyBeswick/plansentry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobeyBeswick/plansentry.git"
  },
  "bugs": {
    "url": "https://github.com/RobeyBeswick/plansentry/issues"
  },
  "type": "module",
  "bin": {
    "plansentry": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && PLANSENTRY_REQUIRE_E2E=1 npm test",
    "demo": "npm run build && node scripts/demo.mjs",
    "gen:stateful": "node scripts/gen-cfn-stateful.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "terraform",
    "opentofu",
    "aws-cdk",
    "cloudformation",
    "claude-code",
    "codex",
    "ai-agents",
    "guardrails",
    "hooks",
    "iac"
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-cdk/cloudformation-diff": "^2.187.6"
  },
  "devDependencies": {
    "@aws-cdk/aws-service-spec": "^0.1.228",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
